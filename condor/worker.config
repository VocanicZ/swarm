# swarm worker (execute point). Filled by install.sh.
NETWORK_INTERFACE = @IP@
UPDATE_INTERVAL = 30
CGROUP_MEMORY_LIMIT_POLICY = none
SUSPEND = False
PREEMPT = False
STARTD_CRON_JOBLIST = SWARM
STARTD_CRON_SWARM_EXECUTABLE = /bin/cat
STARTD_CRON_SWARM_ARGS = /run/swarm/startd.ad
STARTD_CRON_SWARM_MODE = Periodic
STARTD_CRON_SWARM_PERIOD = 10s
SWARM_GATE = isUndefined(TARGET.SwarmCoordRate) || (MY.SwarmCapCores * (60 - TARGET.SwarmInputMB * 8 / MY.SwarmLinkMbps / 60 - 1) >= 0.2 * TARGET.SwarmCoordRate * 60)
# SwarmAdTime: a dead governor's last ad stays in the startd; refuse it after 60 s.
# The negotiator also evaluates this on the collector copy (<= ~42 s old): needs NTP-synced clocks.
START = (MY.SwarmCapCores =!= undefined) && (time() - MY.SwarmAdTime < 60) && (MY.TotalSlotCpus - MY.Cpus + TARGET.RequestCpus <= MY.SwarmCapCores) && (MY.TotalSlotMemory - MY.Memory + TARGET.RequestMemory <= MY.SwarmCapMemoryMB) && ($(SWARM_GATE))
STARTER_ALLOW_RUNAS_OWNER = False
# not a dedicated account: sharing one across slots kills siblings when a shard exits
NOBODY_SLOT_USER = swarm
